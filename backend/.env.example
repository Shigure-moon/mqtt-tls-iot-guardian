# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iot_guardian
DB_USER=your_user
DB_PASSWORD=your_password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# MQTT配置
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=iot_guardian_backend
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# JWT配置
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 证书加密配置（可选）
# CERT_ENCRYPTION_KEY=your_base64_encoded_32_byte_key

# LLM安全集成配置
LLM_IDS_AGENT_ENABLED=true
LLM_IDS_AGENT_API_URL=http://localhost:8001

CYBERSENTINAL_ENABLED=true
CYBERSENTINAL_API_URL=http://localhost:8002

# 威胁响应配置
AUTO_DEVICE_ISOLATION=true
AUTO_CERT_REVOCATION=true
THREAT_RESPONSE_WEBHOOK=
INTERNAL_API_KEY=your_internal_api_key_here

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/var/log/iot-guardian/app.log
LOG_JSON_FORMAT=false
